<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite"
       parallel="methods"
       thread-count="3">

    <listeners>
        <listener class-name="com.shreya.listeners.RetryTransformer"/>
    </listeners>

    <test name="Parallel TestNG Tests">
        <classes>
            <class name="com.shreya.tests.ParallelTest"/>
        </classes>
    </test>

</suite>